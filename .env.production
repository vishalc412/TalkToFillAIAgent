# Production Environment Configuration

# LLM Provider (REQUIRED)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# Speech Processing
STT_PROVIDER=openai
TTS_PROVIDER=openai
TTS_VOICE=alloy
STT_LANGUAGE=en-US

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Redis (Production)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Application Settings
MAX_CONVERSATION_HISTORY=20
SESSION_TIMEOUT_MINUTES=30
ENABLE_LOGGING=true
LOG_LEVEL=INFO

# Security
CORS_ORIGINS=https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=false
