# LLM Provider Configuration
# Choose your primary LLM provider: openai, anthropic, google
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TEMPERATURE=0.7

# Google Gemini Configuration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.0-flash-exp
GOOGLE_TEMPERATURE=0.7

# Speech-to-Text Configuration
STT_PROVIDER=openai  # Options: openai, google, whisper-local
STT_LANGUAGE=en-US

# Text-to-Speech Configuration
TTS_PROVIDER=openai  # Options: openai, google, gtts
TTS_VOICE=alloy  # For OpenAI: alloy, echo, fable, onyx, nova, shimmer

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Redis Configuration (for session management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Application Settings
MAX_CONVERSATION_HISTORY=20
SESSION_TIMEOUT_MINUTES=30
ENABLE_LOGGING=true
LOG_LEVEL=INFO
